# FitUp AI Assistant Environment Configuration

# Server Port
PORT=3000

# Default OpenRouter API Key (Optional fallback if user hasn't provided key in Settings UI)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AES-256 Master Encryption Secret for API Keys stored at rest
ENCRYPTION_SECRET=fitup-master-secret-key-32-bytes-long!

# JWT Authentication Secret
JWT_SECRET=fitup-jwt-secret-key-change-in-production!

# Database Path
DATABASE_PATH=backend/database/app.sqlite
